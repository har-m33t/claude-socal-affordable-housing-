# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Large or raw data (keep folder structure)
data/raw/*
!data/raw/.gitkeep
*.zip
*.gz

# Office temp files
~$*

# Env / secrets (keys live in the environment only; .env.example lists names, no values)
.env
.env.*
!.env.example
*.pem
*.key

# Never commit personal information (real applicants, tenants, residents)
real-data/
private/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
# Anchored: unanchored `coverage/` also matched components/coverage/, so new
# UI files there vanished from git status instead of being tracked.
/coverage/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/

# Hackathon bundle: contents of claude-impact-lab-uci-main.zip.
# Unpacked locally for reference; the zip is the tracked copy, so every
# extracted file stays untracked. Re-extract with:
#   unzip -q claude-impact-lab-uci-main.zip -d .
claude-impact-lab-uci-main/
node_modules




# Env / secrets


# Pointer app (Next.js). Moved from pointer/ to the repo root at integration.
# Team 1 downloads source PDFs here; never committed.
# .env.* above would swallow this, and it is names only - keep it tracked.







# Next.js / Node
__pycache__/
*.pyc
.vercel
.env*
# Re-asserted AFTER the Vercel CLI's `.env*` above, because later patterns win.
# .env.example holds variable NAMES only and must stay tracked; without this it
# would be silently dropped if it were ever removed and re-added.
!.env.example

