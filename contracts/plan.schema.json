{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pointer/contracts/plan.schema.json",
  "title": "Multi-step plan",
  "description": "Documents, pointer targets and ordered steps for one city and project type. Target ids are the agent's item_id space (they include the city checklist ids). Mirrors components/pointer/plan.ts.",
  "type": "object",
  "required": [
    "about",
    "city",
    "project_type",
    "checked_date",
    "documents",
    "targets",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "about": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "project_type": {
      "type": "string"
    },
    "checked_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pdf",
              "packet"
            ]
          },
          "url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "checked_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "made_up": {
            "type": "boolean"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "doc",
          "label",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "doc": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "source_url": {
            "type": "string"
          },
          "summary": {
            "type": "boolean",
            "description": "Packet documents only: a board-level target, not a file slot."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "doc",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "organize",
              "read",
              "law",
              "form",
              "gather",
              "final"
            ]
          },
          "doc": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
