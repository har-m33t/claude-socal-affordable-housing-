# Names only. Never commit real values.
# The agent route reads the key from this variable and nothing else.
ANTHROPIC_API_KEY=

# Optional. Absolute or repo-relative path to the HCD ADU Handbook PDF.
# Team 1 downloads it to pointer/data/raw/adu-handbook.pdf (git-ignored).
# When unset or missing, the agent runs without the handbook and says so.
POINTER_HANDBOOK_PDF=

# Optional caps. Defaults live in lib/agent/config.ts.
POINTER_MAX_STEPS=
POINTER_MAX_TOKENS=
