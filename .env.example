# Copy to .env.local and fill in. Never commit the filled-in file.
# Server-side only: read by app/api/agent/ and never sent to the browser.
ANTHROPIC_API_KEY=

# --- Pointer agent backend (Team 3) ---
# Optional. Path to the HCD ADU Handbook PDF; absent is reported, never faked.
POINTER_HANDBOOK_PDF=
# Caps. Junk, negative or non-integer values fall back to the defaults.
POINTER_MAX_STEPS=
POINTER_MAX_TOKENS=
POINTER_RATE_LIMIT_MAX=
POINTER_RATE_LIMIT_GLOBAL_MAX=
POINTER_RATE_LIMIT_WINDOW_MS=
# "1" reads x-forwarded-for / x-real-ip for per-client rate-limit keying.
POINTER_TRUST_PROXY=
# "1" AND a non-production NODE_ENV lets a run overwrite fixtures/replay.json.
POINTER_ALLOW_RECORD=

# --- Durable rate limiting (optional but REQUIRED for a public deployment) ---
# Injected automatically by the Vercel Marketplace when an Upstash Redis store
# is attached to the project. Either naming works.
#
# WHY IT MATTERS: without these the limiter counts in process memory, and each
# serverless instance has its own. On Vercel that turns a cap of
# POINTER_RATE_LIMIT_GLOBAL_MAX runs per window into that many PER INSTANCE,
# which is no real ceiling at all once ANTHROPIC_API_KEY is set on a public URL.
# With them, every instance increments the same counter.
#
# If they are absent, or Redis errors, the app falls back to the in-process
# limiter rather than failing runs or removing the ceiling.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or, equivalently:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

